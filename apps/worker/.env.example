# ── Worker process ────────────────────────────────────────────────────────────
NODE_ENV=development

# Redis connection
REDIS_URL=redis://localhost:6379

# Queue isolation (separate Redis DB index, 0-15)
REDIS_QUEUE_DB=1

# Queue name (default: "queue")
REDIS_QUEUE_NAME=queue

# Worker concurrency (parallel jobs, default: 5)
WORKER_CONCURRENCY=5

# Health-check HTTP server port (default: 9090)
WORKER_HEALTH_PORT=9090
