# ── Auth Service ──────────────────────────────────────────────────────────────
NODE_ENV=development

# Redis connection (cache)
REDIS_URL=redis://localhost:6379

# Queue isolation (separate Redis DB index, 0-15)
REDIS_QUEUE_DB=1

# Queue name
REDIS_QUEUE_NAME=queue

# Server port
PORT=4000

# JWT / Auth
# JWT_SECRET=your-secret-min-32-chars
# SERVICE_TOKEN=your-token-min-32-chars
