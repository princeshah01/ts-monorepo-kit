{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "prepare": {
      "dependsOn": ["^prepare"]
    },
    "lint": { "dependsOn": ["prepare"] },
    "format": { "dependsOn": ["prepare"] },
    "check-types": { "dependsOn": ["prepare"] },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
