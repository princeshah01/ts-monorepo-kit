{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "SESSION_SECRET",
    "AUTH_PORT",
    "QUEUE_NAME",
    "WORKER_CONCURRENCY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "prepare": {
      "dependsOn": ["^prepare"]
    },
    "lint": { "dependsOn": ["prepare"] },
    "lint:fix": { "dependsOn": ["prepare"] },
    "check-types": { "dependsOn": ["prepare"] },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
