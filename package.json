{
  "name": "turbo-backend-starter",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "env-cmd -f .env turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "check-types": "turbo run check-types",
    "db:migrate": "env-cmd -f .env turbo run db:migrate"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.7.4",
    "turbo": "^2.8.20",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.4",
      "ioredis": "5.10.1",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "env-cmd": "^11.0.0"
  }
}
